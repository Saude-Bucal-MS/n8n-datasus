{
  "name": "ETL DATASUS - Saúde Bucal MS",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const arquivosExistentes = $input.all()\n  .map(item => item.json.nome_arquivo)\n  .filter(a => a && a.startsWith('PAMS'))\n  .map(a => a.replace('.sqlite', ''));\n\nconst INICIO = { ano: 2023, mes: 11 };\n\nconst hoje = new Date();\nconst limite = new Date(hoje.getFullYear(), hoje.getMonth(), 1);\n\nconst mesesEsperados = [];\nlet cursor = new Date(INICIO.ano, INICIO.mes - 1, 1);\n\nwhile (cursor <= limite) {\n  const yy = String(cursor.getFullYear()).slice(-2);\n  const mm = String(cursor.getMonth() + 1).padStart(2, '0');\n  mesesEsperados.push('PAMS' + yy + mm);\n  cursor.setMonth(cursor.getMonth() + 1);\n}\n\nconst faltando = mesesEsperados.filter(p => !arquivosExistentes.includes(p));\n\nreturn faltando.map(pattern => ({ json: { pattern } }));"
      },
